{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskbox.app/schemas/custom-widget-manifest.v1.json",
  "title": "DeskBox Custom Widget Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "root",
    "elements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "minAppVersion": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "official",
        "local",
        "package",
        "community",
        "agent",
        "ai"
      ]
    },
    "isCustomized": {
      "type": "boolean"
    },
    "forkedFromId": {
      "type": "string"
    },
    "forkedFromVersion": {
      "type": "string"
    },
    "createdAtUtc": {
      "type": "string"
    },
    "updatedAtUtc": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "minSize": {
      "$ref": "#/$defs/sizeSpec"
    },
    "defaultSize": {
      "$ref": "#/$defs/sizeSpec"
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/settingDef"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "object"
        ]
      }
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "maxItems": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "sort": {
            "type": "string",
            "enum": [
              "newestFirst",
              "oldestFirst"
            ]
          },
          "seedItems": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "systemMetrics",
              "storageDrives",
              "pomodoro",
              "countdown",
              "aiMonitor",
              "weather",
              "calendar",
              "clock",
              "deviceState",
              "clipboard",
              "music",
              "todo",
              "rss",
              "httpJson",
              "fileText",
              "command"
            ]
          },
          "path": {
            "type": "string"
          },
          "stateKey": {
            "type": "string"
          },
          "executable": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workingDirectory": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "targetCollection": {
            "type": "string"
          },
          "itemsPath": {
            "type": "string"
          },
          "maxItems": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "fieldMap": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "stateMap": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "intervalMs": {
            "type": "integer",
            "minimum": 250
          }
        }
      }
    },
    "onDrop": {
      "type": "object",
      "properties": {
        "storage": {
          "type": "string",
          "enum": [
            "reference",
            "copy",
            "auto"
          ]
        },
        "action": {
          "$ref": "#/$defs/actionOrList"
        }
      }
    },
    "script": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "const": "logic.js"
        },
        "tickIntervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "capsule": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "glyph": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "progress": {
          "type": [
            "string",
            "number"
          ]
        },
        "enableBounceOnUpdate": {
          "type": "boolean"
        },
        "badgeIsWarning": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "primaryAction": {
          "type": "object",
          "properties": {
            "icon": {
              "type": "string"
            },
            "tooltip": {
              "type": "string"
            },
            "onClick": {
              "$ref": "#/$defs/actionOrList"
            }
          }
        }
      }
    },
    "popovers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "placement": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "left",
              "right",
              "center"
            ]
          },
          "root": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "elements": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nodeSpec"
      }
    }
  },
  "$defs": {
    "sizeSpec": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 160,
          "maximum": 1600
        },
        "height": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1600
        }
      }
    },
    "optionSpec": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "settingDef": {
      "type": "object",
      "required": [
        "key",
        "type",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "toggle",
            "choice",
            "text",
            "number",
            "file",
            "folder",
            "moduleList",
            "secret"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "accept": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/optionSpec"
          }
        }
      }
    },
    "actionSpec": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "state.set",
            "state.toggle",
            "state.increment",
            "collection.prepend",
            "collection.append",
            "collection.update",
            "collection.remove",
            "collection.clear",
            "collection.exportMarkdown",
            "file.open",
            "file.reveal",
            "file.transform",
            "file.pick",
            "file.listDir",
            "file.manage",
            "text.transform",
            "launcher.open",
            "system.control",
            "system.openSetting",
            "url.open",
            "source.refresh",
            "refreshSource",
            "clipboard.copy",
            "clipboard.captureImage",
            "toast.show",
            "reminder.notify",
            "todo.add",
            "todo.toggle",
            "todo.remove",
            "todo.cyclePriority",
            "todo.clearCompleted",
            "pomodoro.toggle",
            "pomodoro.reset",
            "pomodoro.extend",
            "pomodoro.skip",
            "pomodoro.cyclePhase",
            "pomodoro.setPhase",
            "pomodoro.sedentaryConfirm",
            "pomodoro.sedentarySnooze",
            "countdown.upsert",
            "countdown.pin",
            "countdown.delete",
            "ai.refresh",
            "ai.selectProvider",
            "ai.run",
            "script.run",
            "popover.open",
            "popover.close",
            "popover.toggle",
            "tip.open",
            "tip.close",
            "tip.toggle",
            "audio.cue",
            "audio.play",
            "audio.pause",
            "audio.stop",
            "audio.toggle",
            "audio.setVolume",
            "audio.stopAll",
            "collection.reorder",
            "http.request",
            "job.cancel",
            "command.cancel",
            "file.writeText",
            "command.run"
          ]
        },
        "id": {
          "type": "string"
        },
        "jobKey": {
          "type": "string"
        },
        "guard": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": [
            "copy",
            "move",
            "rename",
            "recycle"
          ]
        },
        "fn": {
          "type": "string"
        },
        "onProgress": {
          "type": "string"
        },
        "onComplete": {
          "type": "string"
        },
        "arg": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "popoverId": {
          "type": "string"
        },
        "fromIndex": {
          "type": [
            "integer",
            "string"
          ]
        },
        "toIndex": {
          "type": [
            "integer",
            "string"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "append": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        },
        "accept": {
          "type": "string"
        },
        "recursive": {
          "type": "boolean"
        },
        "pattern": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "longRunning": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "executable": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ]
        },
        "collection": {
          "type": "string"
        },
        "targetCollection": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "maxWidth": {
          "type": "integer"
        },
        "quality": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "prepend",
            "append",
            "replace",
            "copy",
            "file",
            "folder"
          ]
        },
        "itemsPath": {
          "type": "string"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "stateMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fieldMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "item": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array",
              "object",
              "null"
            ]
          }
        },
        "then": {
          "$ref": "#/$defs/actionOrList"
        }
      }
    },
    "actionOrList": {
      "oneOf": [
        {
          "$ref": "#/$defs/actionSpec"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionSpec"
          }
        }
      ]
    },
    "emptyStateSpec": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        }
      }
    },
    "nodeSpec": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
